# Backend Base Image for Spring Boot
FROM openjdk:21-slim

ENV TZ="Asia/Ho_Chi_Minh"

# Install dependencies for Maven build
ARG MAVEN_VERSION=3.9.6
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates tar gzip && \
    curl -fsSL https://downloads.apache.org/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz \
    | tar xzf - -C /opt && \
    ln -s /opt/apache-maven-${MAVEN_VERSION} /opt/maven && \
    apt-get purge -y curl tar gzip && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

ENV MAVEN_HOME=/opt/maven
ENV PATH="${MAVEN_HOME}/bin:${PATH}"

# Add non-root user
RUN useradd -m appuser
USER appuser

WORKDIR /app
